# Runtime caches and generated model artifacts
.cache/
.venv/

# Product photos are generated from the public dataset by
# tools/pick_product_images.py; uncomment to keep them out of version control.
# public/assets/products/

# CLIP index is regenerated by tools/build_clip_index.py
# data/clip-index.faiss
# data/clip-index-meta.json

# Model weights must never enter git: GitHub rejects files over 100 MB and the
# fp16 bases are 1.6 GB each. They are rebuilt by:
#   tools/prepare_catvton_base.py   (downloaded from the Hugging Face cache)
# Hugging Face's own cache (.cache/hf) is ignored above.
data/models/
*.safetensors
*.ckpt
*.pt
*.pth

# Runtime database (regenerated and seeded on first boot)
data/analytics.db
data/analytics.db-wal
data/analytics.db-shm

# OS / editor noise
Thumbs.db
.DS_Store
*.log
